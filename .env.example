# App plumbing
BIGI_DB=sqlite:///./bigi.db

# --- Credential fallbacks (optional) ----------------------------------------
# Anything you save in the Settings UI (stored in SQLite) takes precedence;
# these are used when the UI value is unset. Keeps tokens out of git/chat/UI —
# copy this file to backend/.env (gitignored) or pass with `docker run -e …`.
BO_BASE_URL=
BO_INTTOKEN=
# When BO_INTTOKEN is empty, the token is read fresh per request from this file
# (same file the finom-bo-local MCP uses — one place to refresh it):
BO_INTTOKEN_FILE=~/.finom-bo/token
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=
